# Optional server voices. Empty values use browser speech.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
OPENAI_API_KEY=
OPENAI_CAST_MODEL=gpt-4o-mini

PREVIEW_LINES=12
MAX_CHARS=1000000
MAX_CATALOG_CHARS=4000000
MAX_EXPORT_CHARS=1000000
IMPORTS_PER_HOUR=20
VOICEEMO_DATA_DIR=
SITE_PASSWORD=
# Optional offline Project Gutenberg CSV or CSV.gz catalog path.
GUTENBERG_CATALOG_PATH=
# Optional generated-files HTTPS mirror base from Project Gutenberg's mirror list.
GUTENBERG_MIRROR_URL=
# Personal mode requires a separate random, URL-safe access key.
TELLER_PERSONAL_MODE=0
TELLER_ACCESS_KEY=

# Use the origin shown in the browser, without a trailing slash.
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls

# An account sign-in method is required to use checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BOOK_PRICE_ID=
STRIPE_WEEKLY_PRICE_ID=
STRIPE_WEEKLY_BOOKS=1
STRIPE_MONTHLY_PRICE_ID=
STRIPE_MONTHLY_BOOKS=1
STRIPE_ANNUAL_PRICE_ID=
STRIPE_ANNUAL_BOOKS=1
